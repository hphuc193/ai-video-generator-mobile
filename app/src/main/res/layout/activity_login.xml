<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <!-- ========================= -->
    <!-- BACKGROUND DECORATION -->
    <!-- ========================= -->

    <View
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:alpha="0.045"
        android:background="@drawable/bg_splash_glow"
        android:translationX="-90dp"
        android:translationY="-90dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:alpha="0.035"
        android:background="@drawable/bg_splash_glow"
        android:translationX="80dp"
        android:translationY="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ========================= -->
    <!-- MAIN CONTENT -->
    <!-- ========================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="92dp"
            android:paddingEnd="24dp"
            android:paddingBottom="28dp">

            <!-- ========================= -->
            <!-- APP BRAND -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Logo -->

                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_splash_logo"
                    android:elevation="3dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:contentDescription="AI.Video Studio"
                        android:src="@drawable/baseline_auto_awesome_24"
                        app:tint="@color/primary_blue" />

                </FrameLayout>

                <!-- App name -->

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI.Video Studio"
                        android:textColor="@color/primary_blue"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="AI VIDEO CREATION"
                        android:textColor="@color/text_sub_light"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12" />

                </LinearLayout>

            </LinearLayout>


            <!-- ========================= -->
            <!-- WELCOME -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="42dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/allan"
                    android:layout_gravity=""
                    android:text="Welcome back!"
                    android:textColor="@color/text_main_light"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/login_subtitle"
                    android:textColor="@color/text_sub_light"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>


            <!-- ========================= -->
            <!-- LOGIN FORM -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:orientation="vertical">

                <!-- Email label -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="Email"
                    android:textColor="@color/text_main_light"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Email -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_input_rounded"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:contentDescription="Email"
                        android:src="@drawable/baseline_email_24"
                        app:tint="@color/primary_blue" />

                    <EditText
                        android:id="@+id/edtEmail"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/hint_email"
                        android:inputType="textEmailAddress"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:singleLine="true"
                        android:textColor="@color/text_main_light"
                        android:textColorHint="@color/text_sub_light"
                        android:textSize="14sp" />

                </LinearLayout>


                <!-- Password label -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp"
                    android:text="Mật khẩu"
                    android:textColor="@color/text_main_light"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Password -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_input_rounded"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:contentDescription="Mật khẩu"
                        android:src="@drawable/baseline_lock_24"
                        app:tint="@color/primary_blue" />

                    <EditText
                        android:id="@+id/edtPassword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/hint_password"
                        android:inputType="textPassword"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:singleLine="true"
                        android:textColor="@color/text_main_light"
                        android:textColorHint="@color/text_sub_light"
                        android:textSize="14sp" />

                </LinearLayout>


                <!-- Login button -->

                <Button
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="28dp"
                    android:background="@drawable/bg_btn_gradient"
                    android:elevation="4dp"
                    android:text="@string/login_btn"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

                <Button
                    android:id="@+id/btnGoogleLogin"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_btn_gradient_gg"
                    android:elevation="4dp"
                    android:text="@string/login_google_btn"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null" />

            </LinearLayout>


            <!-- ========================= -->
            <!-- REGISTER -->
            <!-- ========================= -->

            <TextView
                android:id="@+id/tvGoToRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:clickable="true"
                android:focusable="true"
                android:padding="10dp"
                android:text="@string/no_account_register"
                android:textColor="@color/primary_blue"
                android:textSize="14sp"
                android:textStyle="bold" />


            <!-- ========================= -->
            <!-- FOOTER -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:layout_width="35dp"
                    android:layout_height="1dp"
                    android:alpha="0.25"
                    android:background="@color/text_sub_light" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:text="hphuc with AI"
                    android:textColor="@color/text_sub_light"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.15" />

                <View
                    android:layout_width="35dp"
                    android:layout_height="1dp"
                    android:alpha="0.25"
                    android:background="@color/text_sub_light" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
