<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <!-- BỌC TẤT CẢ NỘI DUNG VÀO SWIPE REFRESH LAYOUT -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Dùng NestedScrollView để cho phép cuộn nội dung nếu nội dung quá dài -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- HEADER: Lời chào và Nút Đăng xuất -->
                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="24dp"
                    android:text="Hi, Nguyễn Văn A"
                    android:textColor="@color/text_main_light"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/btnDarkMode"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/btnDarkMode"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="20dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    android:src="@drawable/baseline_dark_mode_24"
                    app:tint="@color/text_main_light"
                    app:layout_constraintBottom_toBottomOf="@id/tvGreeting"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvGreeting" />

                <!-- THẺ SỐ DƯ CREDIT -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardCredit"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="22dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="16dp"
                    app:layout_constraintTop_toBottomOf="@id/tvGreeting">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <!-- ẢNH BACKGROUND -->
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/bannercreditcard" />

                        <!-- LỚP PHỦ MỜ ĐỂ TEXT DỄ ĐỌC -->


                        <!-- NỘI DUNG CREDIT -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            app:cardElevation="20dp"
                            android:paddingHorizontal="16dp">

                            <!-- ICON -->
                            <FrameLayout
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:gravity="center">

                                <ImageView
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="8dp"
                                    android:src="@drawable/baseline_auto_awesome_24"
                                    app:tint="@color/primary_blue" />

                            </FrameLayout>

                            <!-- TEXT -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="13dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/available_credits"
                                    android:textColor="@color/dark_bg"
                                    android:textStyle="italic"
                                    android:textSize="13sp" />

                                <TextView
                                    android:id="@+id/tvCreditBalance"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="---"
                                    android:textColor="@color/primary_blue"
                                    android:textSize="22sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                            <!-- BADGE -->
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_credit_badge"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="6dp"
                                android:text="@string/credits"
                                android:textColor="@color/primary_blue"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </FrameLayout>

                </androidx.cardview.widget.CardView>

                <!-- NÚT TẠO VIDEO -->
                <androidx.cardview.widget.CardView
                android:id="@+id/btnCreateVideo"
                android:layout_width="match_parent"
                android:layout_height="104dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardCornerRadius="24dp"
                app:cardElevation="20dp"
                app:layout_constraintTop_toBottomOf="@id/cardCredit">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_create_video_modern"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="18dp">
                    <!-- ICON --> <FrameLayout
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:background="@drawable/bg_create_video_icon"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="10dp"
                        android:src="@drawable/baseline_add"
                        app:tint="@color/white" />
                </FrameLayout>
                    <!-- TEXT -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/create_video"
                            android:textColor="@color/white"
                            android:textSize="19sp"
                            android:textStyle="bold" /> <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:alpha="0.85"
                        android:text="@string/create_video_subtitle"
                        android:textColor="@color/white"
                        android:textSize="13sp" />
                    </LinearLayout>
                    <!-- ARROW -->
                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:padding="7dp"
                        android:src="@drawable/baseline_arrow_forward_ios_24"
                        app:tint="@color/white" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

                <!-- HEADER DỰ ÁN GẦN ĐÂY -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layoutRecentHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="24dp"
                    app:layout_constraintTop_toBottomOf="@id/btnCreateVideo">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/recent_projects"
                        android:textColor="@color/text_main_light"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvViewAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingVertical="8dp"
                        android:text="@string/view_all"
                        android:textColor="@color/primary_blue"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- DANH SÁCH VIDEO -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvVideos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingBottom="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/layoutRecentHeader"
                    app:layout_constraintVertical_bias="0.0"
                    tools:layout_editor_absoluteX="89dp" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- THANH ĐIỀU HƯỚNG DƯỚI CÙNG (Giữ nguyên bên ngoài) -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_floating_nav"
        android:elevation="8dp"
        android:padding="2dp"
        app:itemActiveIndicatorStyle="@null"
        app:itemBackground="@drawable/selector_nav_item_bg"
        app:itemIconSize="26dp"
        app:itemIconTint="@drawable/selector_nav_icon"
        app:labelVisibilityMode="unlabeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_menu" />
</androidx.constraintlayout.widget.ConstraintLayout>