<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="150dp"
    android:layout_height="165dp"
    android:layout_marginEnd="12dp"
    app:cardBackgroundColor="@color/select_nav"
    app:cardCornerRadius="18dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Label -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/credit_packages"
            android:textColor="@color/text_secondary_light"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Credit -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCreditAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100"
                android:textColor="@color/text_main_light"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="5dp"
                android:text="Credit"
                android:textColor="@color/text_secondary_light"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Description -->

        <TextView
            android:id="@+id/tvPackageDescription"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/credit_used_for_ai"
            android:textColor="@color/text_secondary_light"
            android:textSize="10sp" />

        <!-- Price -->

        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="49.000 ₫"
            android:textColor="@color/primary_blue"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Buy -->

        <TextView
            android:id="@+id/btnBuy"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_package_buy"
            android:gravity="center"
            android:text="@string/buy_package"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.cardview.widget.CardView>